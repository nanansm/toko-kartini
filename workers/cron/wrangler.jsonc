{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Akun Simaung.coorporate. Dipatok di sini, bukan diserahkan ke
  // CLOUDFLARE_ACCOUNT_ID, karena env di mesin ini menunjuk akun lain dan
  // deploy tanpa patokan akan mendarat di akun yang salah.
  "account_id": "0fdd5878683b65122760dbd0bab5256e",
  "name": "kartini-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  // KV yang sama dengan Worker aplikasi (kartini-gudang). Cron menulis, aplikasi membaca.
  "kv_namespaces": [{ "binding": "KATALOG", "id": "fb66d0883e8c4545928f9411db197aa1" }],
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
