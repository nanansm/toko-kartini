{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Akun Simaung.coorporate. Dipatok di sini, bukan diserahkan ke
  // CLOUDFLARE_ACCOUNT_ID, karena env di mesin ini menunjuk akun lain dan
  // deploy tanpa patokan akan mendarat di akun yang salah.
  "account_id": "0fdd5878683b65122760dbd0bab5256e",
  "name": "kartini-gudang",
  "main": "worker-entry.js",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
  "kv_namespaces": [
    { "binding": "KATALOG", "id": "fb66d0883e8c4545928f9411db197aa1" },
    { "binding": "SESI", "id": "9008e3eb5fdd4524aea491e667cdaf53" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PENULIS", "class_name": "Penulis" },
      { "name": "GERBANG", "class_name": "Gerbang" },
      { "name": "BUKU", "class_name": "Buku" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Penulis"] },
    { "tag": "v2", "new_sqlite_classes": ["Gerbang"] },
    { "tag": "v3", "new_sqlite_classes": ["Buku"] }
  ],
  // Alamat resmi aplikasi. Dicatat di sini, bukan diklik di dasbor, supaya
  // deploy dari mesin mana pun memasang domain yang sama dan tidak ada
  // alamat kedua yang hidup diam-diam. Zona simaung.com ada di akun yang
  // sama dengan Worker ini (0fdd5878...), syarat wajib custom_domain.
  //
  // Alamat *.workers.dev TETAP hidup dan sengaja tidak dimatikan: kalau
  // pemasangan domain gagal atau DNS-nya bermasalah, itu jalan masuk yang
  // tersisa untuk memeriksa aplikasinya.
  "routes": [{ "pattern": "sokartini.simaung.com", "custom_domain": true }],
  // WAJIB ditulis eksplisit: begitu "routes" ada, wrangler MEMATIKAN alamat
  // *.workers.dev secara diam-diam kecuali baris ini dipasang.
  "workers_dev": true,
  "observability": { "enabled": true }
}
