# Salin jadi .env.local lalu isi. Berkas .env.local TIDAK PERNAH di-commit.
# Di Cloudflare, semua ini dipasang lewat `wrangler secret put <NAMA>`.

# Akun layanan Google. Satu baris JSON penuh, atau versi base64-nya.
# Izin: Master Pricelist = BACA SAJA. Operasional & Admin = baca-tulis.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# ID spreadsheet (bagian di antara /d/ dan /edit pada URL-nya)
SHEET_PRICELIST_ID=
SHEET_OPS_ID=
SHEET_ADMIN_ID=

# Garam rahasia hash PIN. Acak, panjang, dan tidak pernah ikut ditulis ke spreadsheet.
PIN_PEPPER=
