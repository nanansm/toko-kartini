{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local",
    "**/.env"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "NODE_ENV",
        "SHEET_PRICELIST_ID",
        "SHEET_OPS_ID",
        "SHEET_ADMIN_ID",
        "GOOGLE_SERVICE_ACCOUNT_JSON",
        "PIN_PEPPER"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "type-check": {
      "dependsOn": [
        "^build"
      ]
    },
    "preview": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ]
    },
    "deploy": {
      "cache": false,
      "dependsOn": [
        "^build"
      ]
    }
  }
}
